# ---------------------------------------------------------------------------
# PathPoint_BD API - environment template
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# MongoDB Atlas (mongodb+srv://<user>:<pass>@<cluster>/path_point?retryWrites=true&w=majority)
MONGODB_URI=mongodb://127.0.0.1:27017/path_point

# Auth
JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
JWT_ISSUER=pathpoint-bd
JWT_AUDIENCE=pathpoint-bd-api
BCRYPT_ROUNDS=12

# CORS - comma separated allowlist (Next.js dev + deployed frontend)
CORS_ORIGINS=http://localhost:3000,https://pathpoint-bd.vercel.app

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

# Geospatial defaults (metres)
GEO_DEFAULT_PICKUP_RADIUS_M=3000
GEO_DEFAULT_DROPOFF_RADIUS_M=3000

# Live traffic (SSE)
# Disable the demo simulator if you want a quiet stream.
TRAFFIC_SIM_ENABLED=true
TRAFFIC_SIM_INTERVAL_MS=15000
SSE_HEARTBEAT_MS=15000
